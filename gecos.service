[Unit]
Description=GeCoS MQTT Server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=pi
Group=pi
Environment=MQTT_HOST=homeassistant.local
Environment=MQTT_BASE_TOPIC=home/gecos
Environment=HA_DISCOVERY=true
EnvironmentFile=-/etc/default/gecos-server
ExecStart=/usr/bin/python3 /usr/local/bin/GeCoS-Server.py \\
	--mqtt-host ${MQTT_HOST} \\
	--mqtt-base-topic ${MQTT_BASE_TOPIC} \\
	--ha-discovery
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
